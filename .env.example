# devinfra — local development infrastructure
#
# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Image currency — last resolved against upstream on 2026-09-07
# ---------------------------------------------------------------------------
# Every *_VERSION value below was compared against the image's own upstream
# registry on 2026-09-07 (Docker Hub, and quay.io for Keycloak), and every tag
# named here was confirmed to publish both linux/amd64 and linux/arm64.
# Currency is judged against upstream, never against whatever happens to be
# running. Each pin is therefore either the current upstream release, or it
# lags for a reason written down and dated here.
#
# Current as of 2026-09-07:
#   POSTGRES_VERSION        0.8.6-pg17   (newest pg17 pgvector tag — see below)
#   REDIS_VERSION           8.10.1-alpine
#   KEYCLOAK_VERSION        26.7.3
#   SILO_VERSION            RELEASE.2026-09-03T13-18-01Z
#   MAILPIT_VERSION         v1.31.1
#   PGADMIN_VERSION         9.17
#   REDISINSIGHT_VERSION    3.8.0
#   FLOWER_VERSION          2.1.0
#   OTEL_COLLECTOR_VERSION  0.160.0
#   PROMETHEUS_VERSION      v3.14.0
#
# Knowingly behind, 2026-09-07 — upgrade drafted, not applied:
#   LOKI_VERSION          3.5.7  -> 3.7.7
#   TEMPO_VERSION         2.9.0  -> 3.0.3    (major, span metrics)
#   GRAFANA_VERSION       12.2.0 -> 13.2.1   (major, ships with Tempo 3)
#
# Reason: this repository only accepts an image bump that has been proved by a
# green strict smoke run against a stack actually running the new image. On
# 2026-09-07 the workstation's container runtime lost its registry pull path —
# `docker pull` hung with no output while the same registries answered curl from
# the host in under 200 ms — so none of these four images could be fetched, and
# no such run was reachable. All four target tags were confirmed present for
# linux/amd64 and linux/arm64 by direct registry API call, so the lag is the
# runtime's, not the tags'. Apply them in the recorded order — RedisInsight,
# then Loki, then Tempo and Grafana together, because the span-metrics wiring
# spans both — one commit each, smoke-verified, once pulls work again.
#
# Held deliberately, not a lag:
#   POSTGRES_VERSION stays on the pg17 line while pgvector publishes pg18 tags.
#   The postgres-data volume is mounted at /var/lib/postgresql/data, a path
#   PostgreSQL 18 abandons, and pg17 matches the enterprise environment this
#   stack stands in for. Only the pgvector component moves; the major does not.

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=devinfra

# Which optional service groups start with a bare `docker compose up`.
# Available profiles: admin, observability
# Core services (postgres, redis, keycloak, minio, mailpit) always start.
COMPOSE_PROFILES=admin,observability

# Bind address for all published ports. 127.0.0.1 keeps the stack off your LAN.
BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL 17 (pgvector)
# ---------------------------------------------------------------------------
# Pinned to 17 to match the enterprise environment. Moving to a pg18 tag also
# requires changing the postgres volume mount path in compose.yaml — see the
# comment there.
POSTGRES_VERSION=0.8.6-pg17
POSTGRES_PORT=5432
POSTGRES_USER=devinfra
POSTGRES_PASSWORD=devinfra
POSTGRES_DB=devinfra

# Extra databases created on first boot (comma-separated, no spaces).
# Owned by POSTGRES_USER. Consumed by docker/postgres/initdb/20-extra-databases.sh
POSTGRES_EXTRA_DATABASES=keycloak,app_test

# ---------------------------------------------------------------------------
# Redis 8 — cache, Celery broker, Celery result backend
# ---------------------------------------------------------------------------
REDIS_VERSION=8.10.1-alpine
REDIS_PORT=6379
REDIS_PASSWORD=devinfra

# Logical database allocation (Redis ships with 16: 0-15)
#   0 = application cache
#   1 = Celery broker
#   2 = Celery result backend
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_BACKEND_DB=2

# ---------------------------------------------------------------------------
# Keycloak 26 — OpenID Connect provider
# ---------------------------------------------------------------------------
KEYCLOAK_VERSION=26.7.3
KEYCLOAK_PORT=8080
KEYCLOAK_MGMT_PORT=9000
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Realm imported on first boot from docker/keycloak/realms/
KEYCLOAK_REALM=devinfra

# Confidential client secret — the realm import wires this into the devinfra-api client.
KEYCLOAK_CLIENT_SECRET=devinfra-local-secret

# ---------------------------------------------------------------------------
# Object storage — S3-compatible
# ---------------------------------------------------------------------------
# Silo, a maintained fork of MinIO. Both minio/minio and minio/mc were
# archived upstream in 2026; the final MinIO release fixed a CVE and was never
# published to a registry. Silo keeps the MINIO_* variable names and the
# on-disk format, so this is an image swap with no data migration.
# The same image also provides `mc`, replacing the archived minio/mc.
SILO_VERSION=RELEASE.2026-09-03T13-18-01Z
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=devinfra
MINIO_ROOT_PASSWORD=devinfra123

# Buckets created on first boot (comma-separated, no spaces).
MINIO_BUCKETS=uploads,artifacts,backups

# ---------------------------------------------------------------------------
# Mailpit — SMTP sink + web UI
# ---------------------------------------------------------------------------
MAILPIT_VERSION=v1.31.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Admin UIs (profile: admin)
# ---------------------------------------------------------------------------
PGADMIN_VERSION=9.17
PGADMIN_PORT=5050
# pgAdmin validates this and refuses to boot otherwise. It rejects both bare
# "dev@localhost" and special-use TLDs (.local, .test), so use a real TLD.
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=devinfra

REDISINSIGHT_VERSION=3.8.0
REDISINSIGHT_PORT=5540

FLOWER_VERSION=2.1.0
FLOWER_PORT=5555

# ---------------------------------------------------------------------------
# Observability (profile: observability)
# ---------------------------------------------------------------------------
OTEL_COLLECTOR_VERSION=0.160.0
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

PROMETHEUS_VERSION=v3.14.0
PROMETHEUS_PORT=9090

LOKI_VERSION=3.5.7
LOKI_PORT=3100

TEMPO_VERSION=2.9.0
TEMPO_PORT=3200

GRAFANA_VERSION=12.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
