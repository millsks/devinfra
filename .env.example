# devinfra — local development infrastructure
#
# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=devinfra

# Which optional service groups start with a bare `docker compose up`.
# Available profiles: admin, observability
# Core services (postgres, redis, keycloak, minio, mailpit) always start.
COMPOSE_PROFILES=admin,observability

# Bind address for all published ports. 127.0.0.1 keeps the stack off your LAN.
BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL 17 (pgvector)
# ---------------------------------------------------------------------------
# Pinned to 17 to match the enterprise environment. Moving to a pg18 tag also
# requires changing the postgres volume mount path in compose.yaml — see the
# comment there.
POSTGRES_VERSION=0.8.1-pg17
POSTGRES_PORT=5432
POSTGRES_USER=devinfra
POSTGRES_PASSWORD=devinfra
POSTGRES_DB=devinfra

# Extra databases created on first boot (comma-separated, no spaces).
# Owned by POSTGRES_USER. Consumed by docker/postgres/initdb/20-extra-databases.sh
POSTGRES_EXTRA_DATABASES=keycloak,app_test

# ---------------------------------------------------------------------------
# Redis 8 — cache, Celery broker, Celery result backend
# ---------------------------------------------------------------------------
REDIS_VERSION=8-alpine
REDIS_PORT=6379
REDIS_PASSWORD=devinfra

# Logical database allocation (Redis ships with 16: 0-15)
#   0 = application cache
#   1 = Celery broker
#   2 = Celery result backend
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_BACKEND_DB=2

# ---------------------------------------------------------------------------
# Keycloak 26 — OpenID Connect provider
# ---------------------------------------------------------------------------
KEYCLOAK_VERSION=26.4.0
KEYCLOAK_PORT=8080
KEYCLOAK_MGMT_PORT=9000
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Realm imported on first boot from docker/keycloak/realms/
KEYCLOAK_REALM=devinfra

# Confidential client secret — the realm import wires this into the devinfra-api client.
KEYCLOAK_CLIENT_SECRET=devinfra-local-secret

# ---------------------------------------------------------------------------
# MinIO — S3-compatible object storage
# ---------------------------------------------------------------------------
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=devinfra
MINIO_ROOT_PASSWORD=devinfra123

# Buckets created on first boot (comma-separated, no spaces).
MINIO_BUCKETS=uploads,artifacts,backups

# ---------------------------------------------------------------------------
# Mailpit — SMTP sink + web UI
# ---------------------------------------------------------------------------
MAILPIT_VERSION=v1.28
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Admin UIs (profile: admin)
# ---------------------------------------------------------------------------
PGADMIN_VERSION=9.9
PGADMIN_PORT=5050
# pgAdmin validates this and refuses to boot otherwise. It rejects both bare
# "dev@localhost" and special-use TLDs (.local, .test), so use a real TLD.
PGADMIN_EMAIL=dev@example.com
PGADMIN_PASSWORD=devinfra

REDISINSIGHT_VERSION=2.70
REDISINSIGHT_PORT=5540

FLOWER_VERSION=2.0
FLOWER_PORT=5555

# ---------------------------------------------------------------------------
# Observability (profile: observability)
# ---------------------------------------------------------------------------
OTEL_COLLECTOR_VERSION=0.140.0
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

PROMETHEUS_VERSION=v3.7.3
PROMETHEUS_PORT=9090

LOKI_VERSION=3.5.7
LOKI_PORT=3100

TEMPO_VERSION=2.9.0
TEMPO_PORT=3200

GRAFANA_VERSION=12.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
