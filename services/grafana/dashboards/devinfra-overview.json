{
  "uid": "devinfra-overview",
  "id": null,
  "title": "devinfra overview",
  "description": "One panel per signal over the whole stack, pinned to the provisioned datasource UIDs. Pick a service in the dropdown; the three panels are the same service seen as traces, logs and metrics. scripts/check_dashboards.py reads its queries out of this file, so a panel edited into a broken query fails `pixi run smoke`.",
  "tags": ["devinfra", "observability"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "weekStart": "",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "description": "Every service.name the collector has forwarded to Prometheus. The same value labels the Loki streams and the Tempo spans, so one pick drives all three panels.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(service_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(service_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "skipUrlSync": false,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Traces — spans reported by $service",
      "description": "TraceQL against Tempo. Click a trace ID to open it; the datasource's tracesToLogsV2 wiring jumps from a span to the Loki lines that span produced.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs — lines emitted by $service",
      "description": "The Loki stream selector the collector's OTLP exporter writes: service.name arrives as the service_name label.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"$service\"}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Metrics — series reported by $service",
      "description": "Every series Prometheus scraped from the collector for this service. resource_to_telemetry_conversion turns the OTLP service.name resource attribute into the service_name label, which is what this selector matches.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "{service_name=\"$service\"}",
          "legendFormat": "{{__name__}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
